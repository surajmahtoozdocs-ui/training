# Create PriceRow directly in Online catalog for search visibility
INSERT_UPDATE PriceRow;product(code,catalogVersion(catalog(id),version))[unique=true];catalogVersion(catalog(id),version)[unique=true];price;currency(isocode)[unique=true];unit(code)[unique=true];approvalStatus(code)[default='approved']
;workflowTestProduct:electronicsProductCatalog:Online;electronicsProductCatalog:Online;99.99;USD;pieces;approved

