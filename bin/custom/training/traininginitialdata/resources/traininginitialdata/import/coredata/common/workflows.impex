# User Groups for Workflows
INSERT_UPDATE UserGroup;UID[unique=true];groups(uid)[mode=append]
;productmanagergroup;employeegroup
;marketingmanagergroup;employeegroup
;financemanagergroup;employeegroup

# Grant permissions to workflow groups
$START_USERRIGHTS;;;;;;;;;
Type;UID;MemberOfGroups;Password;Target;read;change;create;remove;change_perm
UserGroup;productmanagergroup;;;;;;;;
;;;;Workflow;+;;;;;
;;;;WorkflowAction;+;;;;;
UserGroup;marketingmanagergroup;;;;;;;;
;;;;Workflow;+;;;;;
;;;;WorkflowAction;+;;;;;
UserGroup;financemanagergroup;;;;;;;;
;;;;Workflow;+;;;;;
;;;;WorkflowAction;+;;;;;
$END_USERRIGHTS;;;;;

# 1. Product Approval Workflow
INSERT_UPDATE WorkflowTemplate;code[unique=true];name[lang=en];owner(uid);description[lang=en]
;ProductApprovalWorkflow;"Product Approval Workflow";admin;"Workflow to review and synchronize products"

INSERT_UPDATE WorkflowActionTemplate;code[unique=true];workflow(code)[unique=true];name[lang=en];actionType(code);principalAssigned(uid);sendEmail[default=false]
;ProdApp_startAction;ProductApprovalWorkflow;"Start Action";start;admin;
;ProdApp_reviewAction;ProductApprovalWorkflow;"Product Manager Review";normal;productmanagergroup;true
;ProdApp_endAction;ProductApprovalWorkflow;"End Action";end;admin;

INSERT_UPDATE AutomatedWorkflowActionTemplate;code[unique=true];workflow(code)[unique=true];name[lang=en];actionType(code);principalAssigned(uid);jobHandler
;ProdApp_syncAction;ProductApprovalWorkflow;"Auto-Synchronize Product";normal;admin;productApprovalSyncJob

INSERT_UPDATE WorkflowDecisionTemplate;code[unique=true];name[lang=en];actionTemplate(code)
;ProdApp_startDecision;"Start";ProdApp_startAction
;ProdApp_approveDecision;"Approve and Sync";ProdApp_reviewAction
;ProdApp_rejectDecision;"Reject and Edit";ProdApp_reviewAction
;ProdApp_syncDecision;"Sync Finished";ProdApp_syncAction

INSERT_UPDATE WorkflowActionTemplateLinkTemplateRelation;source(code)[unique=true];target(code)[unique=true];andConnectionTemplate;qualifier
;ProdApp_startDecision;ProdApp_reviewAction;false;WorkflowActionTemplateLinkTemplateRelation
;ProdApp_approveDecision;ProdApp_syncAction;false;WorkflowActionTemplateLinkTemplateRelation
;ProdApp_rejectDecision;ProdApp_reviewAction;false;WorkflowActionTemplateLinkTemplateRelation
;ProdApp_syncDecision;ProdApp_endAction;false;WorkflowActionTemplateLinkTemplateRelation


