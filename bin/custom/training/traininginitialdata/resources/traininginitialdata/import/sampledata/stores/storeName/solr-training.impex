# ImpEx for configuring Solr Indexed Properties for Training Storefront
$productCatalog=electronicsProductCatalog
$solrIndexedType=electronicsProductType
$lang=en

# 1. Indexed Types & 2. Indexed Properties & 3. Facets & 4. Autocomplete & 5. Spell Check & 8. Value Provider
# Insert/Update SolrIndexedProperty rows for color, size, gender, brand, and operatingSystem
# Map custom attributes of ElectronicsProduct and Apparel variants into Solr fields.
INSERT_UPDATE SolrIndexedProperty;solrIndexedType(identifier)[unique=true];name[unique=true];type(code);localized[default=false];multiValue[default=false];facet[default=true];facetType(code);facetSort(code);priority;visible;useForSpellchecking[default=false];useForAutocomplete[default=false];fieldValueProvider
;$solrIndexedType;color;string;;;true;Refine;Alpha;1000;true;false;false;colorFacetValueProvider
;$solrIndexedType;size;string;;;true;Refine;Alpha;900;true;false;false;modelPropertyFieldValueProvider
;$solrIndexedType;gender;string;;true;true;Refine;Alpha;800;true;false;false;genderValueProvider
;$solrIndexedType;brand;string;;;true;Refine;Alpha;700;true;true;true;modelPropertyFieldValueProvider
;$solrIndexedType;operatingSystem;string;;;true;Refine;Alpha;600;true;false;false;modelPropertyFieldValueProvider
;$solrIndexedType;modelNumber;string;;;false;;;0;false;true;true;modelPropertyFieldValueProvider
;$solrIndexedType;batteryCapacity;string;;;false;;;0;false;false;false;modelPropertyFieldValueProvider
;$solrIndexedType;warrantyMonths;int;;;false;;;0;false;false;false;modelPropertyFieldValueProvider
;$solrIndexedType;customDescriptionIndex;string;;;false;;;0;false;false;false;trainingCustomDescriptionValueProvider
;$solrIndexedType;customScoreStars;string;;;false;;;0;false;false;false;trainingCustomScoreValueResolver

# English Localized Display Names
UPDATE SolrIndexedProperty;solrIndexedType(identifier)[unique=true];name[unique=true];displayName[lang=$lang]
;$solrIndexedType;color;"Color"
;$solrIndexedType;size;"Size"
;$solrIndexedType;gender;"Gender"
;$solrIndexedType;brand;"Brand"
;$solrIndexedType;operatingSystem;"Operating System"
;$solrIndexedType;modelNumber;"Model Number"
;$solrIndexedType;batteryCapacity;"Battery Capacity"
;$solrIndexedType;warrantyMonths;"Warranty (Months)"
;$solrIndexedType;customDescriptionIndex;"Custom Description"
;$solrIndexedType;customScoreStars;"Custom Score (Stars)"

# 6. Boost Rules / Search Query Properties
# Define query and phrase boosts for brand and modelNumber in search query template
INSERT_UPDATE SolrSearchQueryProperty;indexedProperty(name, solrIndexedType(identifier))[unique=true];searchQueryTemplate(name, indexedType(identifier))[unique=true][default=DEFAULT:$solrIndexedType];ftsPhraseQuery[default=false];ftsPhraseQueryBoost;ftsQuery[default=false];ftsQueryBoost;ftsFuzzyQuery[default=false];ftsFuzzyQueryBoost;ftsWildcardQuery[default=false];ftsWildcardQueryType(code)[default=POSTFIX];ftsWildcardQueryBoost;ftsWildcardQueryMinTermLength;includeInResponse[default=true]
;brand:$solrIndexedType;;true;90;true;90;true;45;;;;;
;modelNumber:$solrIndexedType;;true;100;true;100;true;50;;;;;

# 7. Solr CronJobs & Triggers
# Configure triggers for the full and update indexing cronjobs
INSERT_UPDATE Trigger;cronJob(code)[unique=true];second;minute;hour;day;month;year;relative;active;maxAcceptableDelay
;full-electronicsIndex-cronJob;0;5;3;-1;-1;-1;false;true;-1
;update-electronicsIndex-cronJob;0;5;-1;-1;-1;-1;true;true;-1
